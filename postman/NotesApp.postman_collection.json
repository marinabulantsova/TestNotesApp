				{
					"name": "Create inbox",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json()\r",
									"pm.collectionVariables.set(\"INBOX_ID\", jsonData.id)\r",
									"pm.collectionVariables.set(\"TEMP_USER_EMAIL\", jsonData.emailAddress)"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{MAILSLURP_API_KEY}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "x-auth-token",
									"type": "string"
								},
								{
									"key": "in",
									"value": "header",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{MAILSLURP_BASE_URL}}/createInbox",
							"host": [
								"{{MAILSLURP_BASE_URL}}"
							],
							"path": [
								"createInbox"
							]
						}
					},
					"response": []
				},
				{
					"name": "Wait latest email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"if (jsonData.body) {\r",
									"    var resetToken = jsonData.body.trim().split('/').pop();\r",
									"    resetToken = resetToken.trim();\r",
									"    pm.collectionVariables.set(\"RESET_TOKEN\", resetToken);\r",
									"    \r",
									"} else {\r",
									"    console.log(\"Тело письма пустое или ответ неверный\");\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{MAILSLURP_API_KEY}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "x-auth-token",
									"type": "string"
								},
								{
									"key": "in",
									"value": "header",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{MAILSLURP_BASE_URL}}/waitForLatestEmail?inboxId={{INBOX_ID}}&timeout=30000&unreadOnly=true",
							"host": [
								"{{MAILSLURP_BASE_URL}}"
							],
							"path": [
								"waitForLatestEmail"
							],
							"query": [
								{
									"key": "inboxId",
									"value": "{{INBOX_ID}}"
								},
								{
									"key": "timeout",
									"value": "30000"
								},
								{
									"key": "unreadOnly",
									"value": "true"
								}
							]
						}
					},
					"response": []
				},
